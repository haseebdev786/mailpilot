# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL / Prisma
# Neon writes these: DATABASE_URL is the pooled connection (app runtime) and
# DATABASE_URL_UNPOOLED is the direct connection (Prisma migrate/push/studio).
# Run `neon deploy` to fill them in, or point them at any Postgres instance.
# For Neon, runtime defaults are connection_limit=5, pool_timeout=30,
# connect_timeout=20 and max_idle_connection_lifetime=60 (seconds).
# Explicit DATABASE_URL query parameters override them. Restart after changes.
DATABASE_URL=postgresql://mailpilot:mailpilot@localhost:5432/mailpilot?schema=public
DATABASE_URL_UNPOOLED=postgresql://mailpilot:mailpilot@localhost:5432/mailpilot?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Application crypto and sessions
# 64 hexadecimal characters = 32 bytes for AES-256-GCM.
ENCRYPTION_KEY=
# Optional separate signing key; defaults to ENCRYPTION_KEY when empty.
UNSUBSCRIBE_SIGNING_KEY=

# Demo login (one-click testing account: demo@mailpilot.dev / demo1234)
DEMO_LOGIN_ENABLED=true

# Google OAuth (optional for local email/password-only development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Connect SMTP/IMAP in the Mailboxes page. Credentials are encrypted in PostgreSQL.
# Port 587 uses STARTTLS (SMTP secure=false); port 465 uses implicit TLS (true).
# Private/local mail hosts are blocked. This development-only switch permits them.
ALLOW_PRIVATE_MAIL_SERVERS=false

# AI recommendations, per-contact generation, follow-ups and reply drafting.
# With no key, editable starter templates still work; disable AI follow-ups.
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Email verification and password reset (public launch: set to true).
# Verification/reset links are emailed only when a transactional sender is set;
# otherwise the flow still works, but no email is delivered (see README).
EMAIL_VERIFICATION_REQUIRED=false
# Transactional mail for verification/reset emails (separate from user mailboxes).
TRANSACTIONAL_SMTP_HOST=
TRANSACTIONAL_SMTP_PORT=587
TRANSACTIONAL_SMTP_USER=
TRANSACTIONAL_SMTP_PASS=
MAIL_FROM=

# Stripe billing (public paid launch).
# Create products/prices in Stripe, then paste the price ids here. The webhook
# endpoint is /api/billing/webhooks; use its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=

# Gmail / Outlook mailbox OAuth (in addition to SMTP/IMAP).
# Google mail OAuth may reuse GOOGLE_CLIENT_ID/SECRET, or use these dedicated
# values. Callbacks must match the registered redirect URIs exactly.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_CALLBACK_URL=http://localhost:3000/api/mailboxes/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/mailboxes/oauth/microsoft/callback
