{
  "name": "mailpilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "redis:up": "node scripts/ensure-redis.mjs",
    "dev:web": "npm run dev --workspace @mailpilot/web",
    "predev:worker": "node scripts/ensure-redis.mjs",
    "dev:worker": "npm run dev --workspace @mailpilot/worker",
    "build": "npm run build --workspace @mailpilot/web",
    "start": "npm run start --workspace @mailpilot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace @mailpilot/web",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:reset-demo": "npm run db:deploy && npm run db:seed",
    "worker": "npm run start --workspace @mailpilot/worker",
    "format": "prettier --write .",
    "test": "node --import tsx --test tests/core.test.ts",
    "test:integration": "node --import tsx scripts/integration-test.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "concurrently": "^9.1.2",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.5.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "msgpackr-extract": false
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
